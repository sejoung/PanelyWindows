{
  "schemaVersion": 1,
  "units": "DIP except explicitly marked image pixels/bytes/seconds",
  "origin": "source snapshot plus documented Windows decisions",
  "colors": {
    "bgPrimary": "#0F1115",
    "bgSecondary": "#1C1F26",
    "bgTertiary": "#2A2E36",
    "textPrimary": "#E6EAF2",
    "textSecondary": "#AAB2C0",
    "borderSubtle": {
      "rgb": "#FFFFFF",
      "alpha": 0.08
    },
    "accentPrimary": "#0A84FF"
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24
  },
  "typography": {
    "windowsFontFallback": [
      "Segoe UI Variable",
      "Segoe UI",
      "Malgun Gothic"
    ],
    "title": {
      "size": 20,
      "weight": 600
    },
    "body": {
      "size": 14,
      "weight": 400
    },
    "caption": {
      "size": 12,
      "weight": 400
    }
  },
  "motion": {
    "uiRevealMs": 120,
    "pageTransitionMs": 150,
    "easing": "easeOut",
    "reducedMotion": "disable transitions"
  },
  "window": {
    "minimumContentWidth": 800,
    "minimumContentHeight": 600,
    "caption": "Windows system dimensions"
  },
  "library": {
    "width": 240,
    "hotEdgeWidth": 12,
    "hotEdgeIndicatorWidth": 3,
    "revealDelayMs": 200,
    "dismissDelayMs": 300,
    "overlayShadow": {
      "blackAlpha": 0.45,
      "radius": 14,
      "x": 4,
      "y": 0
    },
    "rowIconWidth": 16,
    "rowVerticalPadding": 2,
    "bookmarkThumbnail": [
      24,
      34
    ],
    "progressRingSize": 11,
    "progressStroke": 1.5
  },
  "toolbar": {
    "inset": 12,
    "horizontalPadding": 8,
    "verticalPadding": 4,
    "height": 40,
    "radius": 10,
    "borderWidth": 1,
    "itemGap": 4,
    "dividerHeight": 18,
    "hoverZoneHeight": 80,
    "fallbackBackgroundAlpha": 0.94,
    "iconButton": {
      "width": 32,
      "height": 32,
      "radius": 6,
      "glyphSize": 14,
      "glyphWeight": 500
    }
  },
  "slider": {
    "horizontalInset": 24,
    "bottomInset": 16,
    "trackHeight": 2,
    "thumbDiameter": 10,
    "hitHeight": 20,
    "translatedMarksHeight": 2
  },
  "thumbnails": {
    "width": 148,
    "imageWidth": 112,
    "defaultAspectRatio": 1.5,
    "aspectRatioClamp": [
      0.3,
      3
    ],
    "spacing": 8,
    "padding": 8,
    "radius": 4,
    "activeStroke": 2
  },
  "overlays": {
    "statusTopInset": 60,
    "translationBottomInset": 76,
    "volumeCard": {
      "maxWidth": 360,
      "padding": 16,
      "radius": 14,
      "edgeInset": 24,
      "shadowBlackAlpha": 0.35,
      "shadowRadius": 18,
      "shadowY": 6
    },
    "loading": {
      "scrimBlackAlpha": 0.45,
      "paddingX": 16,
      "paddingY": 12,
      "radius": 12
    }
  },
  "panels": {
    "translationWidth": 340,
    "exportWidth": 460,
    "aiChatWidth": 520,
    "settingsMinSize": [
      560,
      280
    ],
    "jobsInitialSize": [
      500,
      560
    ],
    "jobsMinSize": [
      420,
      320
    ]
  },
  "reader": {
    "minimumZoom": 0.1,
    "maximumZoom": 10,
    "zoomStep": 1.25,
    "fitTolerance": 0.001,
    "doubleClickFitTolerance": 0.01,
    "doubleClickFactor": 2,
    "sourceContinuousZoomSensitivity": 0.01,
    "windowsDiscreteZoomDeltaPerNotch": 10,
    "wheelPreciseThresholdDIP": 60,
    "wheelDiscreteCooldownMs": 300,
    "wheelPhaselessResetMs": 250,
    "verticalEdgeEpsilonDoc": 0.5,
    "wheelEdgeEpsilonDoc": 1
  },
  "limits": {
    "extractedBytes": 5368709120,
    "extractionCacheBytes": 10737418240,
    "nestedWalkDepth": 3,
    "positions": 4000,
    "progress": 4000,
    "series": 2000,
    "recents": 50,
    "recentMenu": 10,
    "bookmarksPerBook": 500,
    "bookmarkedBooks": 200,
    "exportHistory": 50,
    "saveDebounceMs": 2000,
    "libraryAutoRefreshDebounceMs": 1500,
    "imageCacheCount": 100,
    "imageMemoryMinBytes": 157286400,
    "imageMemoryMaxBytes": 1073741824,
    "imageMemoryRAMFraction": 0.0625,
    "preloadRadius": 2,
    "verticalInitialRadius": 3,
    "verticalVisibleBuffer": 2,
    "verticalKeepBuffer": 10,
    "logMaxBytes": 786432,
    "logTrimBytes": 393216,
    "reportLogBytes": 262144
  },
  "defaults": {
    "layout": "single",
    "direction": "leftToRight",
    "fitMode": "fitScreen",
    "sidebarPinned": true,
    "toolbarPinned": false,
    "thumbnailSidebarVisible": false,
    "autoFitOnResize": true,
    "doublePageCoverAlone": false,
    "wheelPageTurn": true,
    "reopenLastFolderOnLaunch": true,
    "appLanguage": "system",
    "translationEnabled": false,
    "translationMatchesSpeechLevel": true,
    "translationMode": "fast",
    "translationTargetLanguage": null,
    "translationOverlayVisible": true,
    "translationBalloonTipDismissed": false,
    "logLevel": "info",
    "libraryAutoRefreshEnabled": true,
    "exportFormat": "cbz",
    "untranslatedPolicy": "translateFirst"
  },
  "translation": {
    "languages": [
      "ja",
      "zh-Hans",
      "zh-Hant",
      "ko",
      "en"
    ],
    "detectorInput": [
      1,
      3,
      640,
      640
    ],
    "detectorThreshold": 0.4,
    "ocrMinTileHeightPx": 2400,
    "ocrOverlapFraction": 0.4166666666666667,
    "ocrSeamMarginPx": 6,
    "duplicateOverlapThreshold": 0.5,
    "balloonInteriorShare": 0.66,
    "patchGlyphPaddingFraction": 0.3,
    "jpegQuality": 0.92
  }
}
