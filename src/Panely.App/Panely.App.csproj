<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>Panely.App</RootNamespace>
    <AssemblyName>Panely</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Panely.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64;ARM64;AnyCPU</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Panely.Domain\Panely.Domain.csproj" />
    <ProjectReference Include="..\Panely.Core\Panely.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Panely.Tests" />
    <InternalsVisibleTo Include="Panely.App.Tests" />
  </ItemGroup>

  <!-- Reader-only build switch: dotnet build -p:PanelyNoTranslation=true (translation module excluded; the app falls back to NullTranslationFeature). -->
  <ItemGroup Condition="'$(PanelyNoTranslation)' == 'true'">
    <Compile Remove="Translation\**" />
    <Page Remove="Translation\**" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Panely.ico" />
    <Resource Include="Assets\panely-256.png" />
    <Resource Include="Assets\panely-48.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Decode fallback for clean PCs whose WIC lacks HEIC/HEIF/WebP codecs (Apache-2.0). -->
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="15.0.0" />
  </ItemGroup>

</Project>
