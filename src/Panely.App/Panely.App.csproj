<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>Panely.App</RootNamespace>
    <AssemblyName>Panely</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Panely.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64;ARM64;AnyCPU</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Panely.Domain\Panely.Domain.csproj" />
    <ProjectReference Include="..\Panely.Core\Panely.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Panely.Tests" />
    <InternalsVisibleTo Include="Panely.App.Tests" />
  </ItemGroup>

  <!-- Reader-only build switch: dotnet build -p:PanelyNoTranslation=true (translation module excluded; the app falls back to NullTranslationFeature). -->
  <ItemGroup Condition="'$(PanelyNoTranslation)' == 'true'">
    <Compile Remove="Translation\**" />
    <Page Remove="Translation\**" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Panely.ico" />
    <Resource Include="Assets\panely-256.png" />
    <Resource Include="Assets\panely-48.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Decode fallback for clean PCs whose WIC lacks HEIC/HEIF/WebP codecs (Apache-2.0). -->
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="15.0.0" />
    <!-- GPU 추론(DirectML 실행 공급자)용 재배포 DirectML.dll. ONNX Runtime DirectML 패키지가 의존하는 버전과 맞춘다. -->
    <PackageReference Include="Microsoft.AI.DirectML" Version="1.15.4" ExcludeAssets="build" GeneratePathProperty="true" />
    <!-- llama.cpp 네이티브(번역 모델). CPU는 x64(AVX 단계별)·ARM64, Vulkan GPU는 win-x64만 있다. -->
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.30.0" />
    <PackageReference Include="LLamaSharp.Backend.Vulkan.Windows" Version="0.30.0" />
  </ItemGroup>

  <!--
    LLamaSharp 백엔드 패키지는 props로 LLamaSharpRuntimes를 복사하는데, RID가 없거나(개발 빌드) 그 RID 폴더가 없으면(win-arm64의 Vulkan)
    모든 OS 파일을 통째로 복사한다. 복사 전에 이 앱이 쓰는 Windows RID 파일만 남긴다(RID가 없으면 win-x64).
  -->
  <Target Name="KeepOnlyWindowsLlamaNatives" BeforeTargets="AssignTargetPaths">
    <PropertyGroup>
      <_LlamaRid>$(RuntimeIdentifier)</_LlamaRid>
      <_LlamaRid Condition="'$(_LlamaRid)' == ''">win-x64</_LlamaRid>
    </PropertyGroup>
    <ItemGroup>
      <_LlamaNative Include="@(Content)" Condition="$([System.String]::Copy('%(Content.FullPath)').Contains('LLamaSharpRuntimes'))" />
      <_LlamaKeep Include="@(_LlamaNative)" Condition="$([System.String]::Copy('%(_LlamaNative.FullPath)').Contains('LLamaSharpRuntimes\$(_LlamaRid)'))" />
      <Content Remove="@(_LlamaNative)" />
      <Content Include="@(_LlamaKeep)" />
    </ItemGroup>
  </Target>

  <!--
    Microsoft.AI.DirectML의 build 타깃은 PlatformTarget이 x64/ARM64일 때만 DirectML.dll을 복사한다(이 앱은 AnyCPU로 빌드).
    복사가 없으면 Windows 시스템의 DirectML.dll을 쓰게 되는데, 오래된 PC에서는 ONNX Runtime 요구 버전보다 낮을 수 있다.
    그래서 게시 대상(RuntimeIdentifier)에 맞는 DirectML.dll을 앱 폴더에 직접 넣는다. RID가 없으면(개발 빌드) x64.
  -->
  <ItemGroup>
    <None Include="$(PkgMicrosoft_AI_DirectML)\bin\arm64-win\DirectML.dll" Condition="'$(RuntimeIdentifier)' == 'win-arm64'" Link="DirectML.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(PkgMicrosoft_AI_DirectML)\bin\x64-win\DirectML.dll" Condition="'$(RuntimeIdentifier)' != 'win-arm64'" Link="DirectML.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- ONNX Runtime 패키지의 네이티브 폴더에 든 링크용 import library(onnxruntime.lib)는 실행에 필요 없으므로 게시본에서 뺀다. -->
  <Target Name="ExcludeImportLibrariesFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.lib'" />
    </ItemGroup>
  </Target>

</Project>
