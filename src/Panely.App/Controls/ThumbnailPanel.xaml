<UserControl x:Class="Panely.App.Controls.ThumbnailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="148" Background="{DynamicResource Brush.BgSecondary}">
    <Border BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1,0,0,0">
        <ListBox x:Name="List" Padding="8" SelectionMode="Single"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True"
                 KeyboardNavigation.TabNavigation="Once">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="FocusVisualStyle" Value="{StaticResource Panely.FocusVisual}" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel HorizontalAlignment="Center" Width="112" ToolTip="{Binding Tooltip}">
                        <Grid Width="112" Height="{Binding ImageHeight}">
                            <Border x:Name="Frame" CornerRadius="4" Background="{DynamicResource Brush.BgTertiary}" ClipToBounds="True">
                                <Image Source="{Binding Image}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <Border x:Name="Active" CornerRadius="4" BorderThickness="2" BorderBrush="{DynamicResource Brush.Accent}" Visibility="Collapsed" />
                            <Border Width="16" Height="16" CornerRadius="8" Background="{DynamicResource Brush.Accent}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,4,4,0" Visibility="{Binding TranslatedVisibility}" ToolTip="{Binding TranslatedTooltip}">
                                <Path Data="M3,8 L6.5,11.5 L13,4.5" Stroke="White" StrokeThickness="2" Stretch="Uniform" Margin="4" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding Caption}" HorizontalAlignment="Center" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource Brush.TextSecondary}" />
                    </StackPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter TargetName="Active" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Border>
</UserControl>
