<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Panely.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Panely.Domain\Panely.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\localization.catalog.json" LogicalName="Panely.localization.catalog.json" />
    <EmbeddedResource Include="Localization\Strings\*.json" LogicalName="Panely.strings.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Panely.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <!-- 번역 모델(Gemma 4 GGUF)을 앱 안에서 돌리는 llama.cpp 바인딩. 네이티브 백엔드는 RID가 있는 Panely.App에서 참조한다(ADR 0008). -->
    <PackageReference Include="LLamaSharp" Version="0.30.0" />
    <PackageReference Include="SharpCompress" Version="0.50.5" />
  </ItemGroup>

</Project>

